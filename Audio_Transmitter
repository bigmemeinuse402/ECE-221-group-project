
#include <Arduino.h>
#include <WiFi.h>
#include <esp_now.h>
#include <esp_wifi.h>
#include <ESP_I2S.h>
#include <cstring>

// Microphone connections
#define MIC_BCLK 14
#define MIC_WS    5
#define MIC_DATA 11

#define SAMPLE_RATE 16000
#define AUDIO_SAMPLES 100

// MAC address of walkie-talkie 2
uint8_t receiverMAC[] = {
  0x90, 0xDA, 0x72, 0x4B, 0x04, 0x94
};

I2SClass microphone;

struct AudioPacket {
  uint32_t sequence;
  int16_t samples[AUDIO_SAMPLES];
};

AudioPacket packet;
int32_t micBuffer[AUDIO_SAMPLES * 2];

uint32_t sequenceNumber = 0;
uint32_t sentPackets = 0;
uint32_t failedPackets = 0;

void onSent(
  const wifi_tx_info_t *info,
  esp_now_send_status_t status
) {
  if (status == ESP_NOW_SEND_SUCCESS) {
    sentPackets++;
  } else {
    failedPackets++;
  }
}

void setup() {
  Serial.begin(115200);
  delay(1500);

  Serial.println("Starting wireless audio transmitter...");

  // Initialize microphone
  microphone.setPins(
    MIC_BCLK,
    MIC_WS,
    -1,
    MIC_DATA
  );

  if (!microphone.begin(
    I2S_MODE_STD,
    SAMPLE_RATE,
    I2S_DATA_BIT_WIDTH_32BIT,
    I2S_SLOT_MODE_STEREO
  )) {
    Serial.println("Microphone setup failed!");
    while (true) delay(1000);
  }

  Serial.println("Microphone ready!");

  // Initialize Wi-Fi for ESP-NOW
  WiFi.mode(WIFI_STA);
  WiFi.disconnect();

  esp_wifi_set_channel(1, WIFI_SECOND_CHAN_NONE);

  if (esp_now_init() != ESP_OK) {
    Serial.println("ESP-NOW initialization failed!");
    while (true) delay(1000);
  }

  esp_now_register_send_cb(onSent);

  esp_now_peer_info_t peerInfo = {};
  memcpy(
    peerInfo.peer_addr,
    receiverMAC,
    6
  );

  peerInfo.channel = 1;
  peerInfo.encrypt = false;

  if (esp_now_add_peer(&peerInfo) != ESP_OK) {
    Serial.println("Failed to add receiver!");
    while (true) delay(1000);
  }

  Serial.println("ESP-NOW ready!");
  Serial.println("Transmitting microphone audio...");
}

void loop() {
  size_t bytesRead = microphone.readBytes(
    (char *)micBuffer,
    sizeof(micBuffer)
  );

  if (bytesRead != sizeof(micBuffer)) {
    return;
  }

  packet.sequence = sequenceNumber++;

  // Convert 32-bit microphone audio to 16-bit
  for (int i = 0; i < AUDIO_SAMPLES; i++) {
    int32_t raw = micBuffer[i * 2];
    int32_t sample = raw >> 16;

    // Increase microphone volume
    sample *= 2;

    if (sample > 32767) sample = 32767;
    if (sample < -32768) sample = -32768;

    packet.samples[i] = (int16_t)sample;
  }

  esp_err_t result = esp_now_send(
    receiverMAC,
    (uint8_t *)&packet,
    sizeof(packet)
  );

  if (result != ESP_OK) {
    failedPackets++;
  }

  static unsigned long lastPrint = 0;

  if (millis() - lastPrint >= 3000) {
    lastPrint = millis();

    Serial.print("Packets sent: ");
    Serial.print(sentPackets);

    Serial.print(" | Failed: ");
    Serial.println(failedPackets);
  }
}
